# ============================================================
# AI Proctoring Backend — Environment Variables
# Copy this file to .env and fill in the values before running.
# ============================================================

# --- Required ---
# API key for the OpenRouter LLM gateway (https://openrouter.ai)
# The application will refuse to start if this is absent or empty.
OPENROUTER_API_KEY="your api key"

# --- Optional (defaults shown) ---

# Root logger level. One of: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# Maximum allowed audio upload size in megabytes.
# Requests with a Content-Length header exceeding this value are rejected with HTTP 413.
MAX_AUDIO_SIZE_MB=20

# Confidence threshold for YOLO object detection (0.0 – 1.0).
# Lower values detect more objects but increase false positives.
YOLO_CONFIDENCE=0.25

# Set to true to use CUDA (GPU) for ONNX Runtime inference.
# Requires the onnxruntime-gpu package and a CUDA-capable GPU.
ENABLE_GPU=false

# Number of async worker coroutines for each of the audio and video queues.
# Increase for higher throughput at the cost of more memory usage.
WORKER_POOL_SIZE=4

# Comma-separated list of allowed CORS origins.
# Use ["*"] to allow all origins (suitable for development only).
CORS_ORIGINS=["*"]

# HuggingFace module cache — isolated to this project to prevent stale
# cached model_onnx.py from overriding the local model files.
# Set this to a path inside the project directory.
# Windows example: HF_MODULES_CACHE=D:\STT-API\tv\.hf_modules_cache
# Linux/Docker example: HF_MODULES_CACHE=/app/.hf_modules_cache
HF_MODULES_CACHE=.hf_modules_cache

